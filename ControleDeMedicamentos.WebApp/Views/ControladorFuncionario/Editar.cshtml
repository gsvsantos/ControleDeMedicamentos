@using ControleDeMedicamentos.WebApp.Models

@{
	ViewBag.Titulo = "Edição de Funcionário";
}

@model EditarFuncionarioViewModel;
<link rel="stylesheet" href="~/css/update.css">

<form id="form-funcionario" class="form-body flex-dir-column" action="/funcionarios/editar/@Model.Id" method="post">
	<div class="card">
		<div class="cabecalho">
			<span>INFORME OS NOVOS DADOS</span>
		</div>

		<div class="card-form flex-dir-column">
				<label class="form-label" for="nome">Nome do Funcionário</label>
				<input required class="form-box" type="text" id="nome" name="nome" value="@Model.Nome"/>
				<span class="invalidInput text-break-word" id="nomeInvalidInput"></span>

				<label class="form-label" for="telefone">Telefone do Funcionário</label>
				<input required class="form-box" type="text" id="telefone" name="telefone" value="@Model.Telefone"/>
				<span class="invalidInput text-break-word" id="telefoneInvalidInput"></span>

				<label class="form-label" for="cPF">C.P.F. do Funcionário</label>
				<input required class="form-box" type="text" id="cPF" name="cPF" value="@Model.CPF"/>
				<span class="invalidInput text-break-word" id="cPFInvalidInput"></span>

			<div class="btns-interact">
				<a class="btn" href="/funcionarios/visualizar" value="voltar" formnovalidate>Voltar</a>
				<button class="btn" type="reset">Limpar</button>
				<button class="btn" name="btnSubmit" value="editar">Editar</button>
			</div>
		</div>
	</div>
</form>
@section Scripts {
	<script src="~/js/funcionario.js"></script>
}