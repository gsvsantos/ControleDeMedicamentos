@using ControleDeMedicamentos.WebApp.Models

@{
    ViewBag.Titulo ="Edição de Funcionário";
}

@model EditarFuncionarioViewModel;
<link rel="stylesheet" href="~/css/read.css">
<link rel="stylesheet" href="~/css/update.css">

<form class="form-body flex-dir-column" action="/funcionarios/editar/@Model.Id" method="post">
    <div class="card">
        <div class="cabecalho">
            <span>INFORME OS NOVOS DADOS</span>
        </div>

        <div class="card-form flex-dir-column">
                <label class="form-label" for="nome">Nome do Funcionário</label>
                <input class="form-box" type="text" id="nome" name="nome" value="@Model.Nome"/>
                <label class="form-label" for="telefone">Telefone do Funcionário</label>
                <input class="form-box" type="text" id="telefone" name="telefone" value="@Model.Telefone"/>
                <label class="form-label" for="cpf">CPF do Funcionário</label>
                <input class="form-box" type="text" id="cpf" name="cpf" value="@Model.CPF"/>
                <button class="btnEditar" type="submit">Editar</button>
        </div>
    </div>
</form>