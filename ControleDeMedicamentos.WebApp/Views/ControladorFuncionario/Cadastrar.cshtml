@using ControleDeMedicamentos.WebApp.Models

@{
    ViewBag.Titulo ="Cadastro de Funcionário";
}

@model CadastrarFuncionarioViewModel;
<link rel="stylesheet" href="~/css/create.css">

<form class="form-body flex-dir-column" action="/funcionarios/cadastrar" method="post">
    <div class="card">
        <div class="cabecalho">
            <span>INFORME OS DADOS</span>
        </div>
        
        <div class="card-form flex-dir-column">
                <label class="form-label" for="nome">Nome do Funcionário</label>
                <input required class="form-box" type="text" placeholder="Nome" name="nome" id="nome">

                <label class="form-label" for="telefone">Telefone do Funcionário</label>
                <input required class="form-box" type="text" placeholder="Telefone" name="telefone" id="telefone">

                <label class="form-label" for="cpf">CPF do Funcionário</label>
                <input required class="form-box" type="text" placeholder="C.P.F." name="cpf" id="cpf">

            <div class="btns-interact">
                <a class="btn" href="/funcionarios/visualizar" value="voltar" formnovalidate>Voltar</a>
                <button class="btn" name="btnSubmit" value="cadastrar">Cadastrar</button>
            </div>
        </div>
    </div>
</form>