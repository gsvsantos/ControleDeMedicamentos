@using ControleDeMedicamentos.WebApp.Models

@{
    ViewBag.Titulo = "Edição de Medicamento";
}

@model EditarMedicamentoViewModel;
<link rel="stylesheet" href="~/css/read.css">
<link rel="stylesheet" href="~/css/update.css">

<form class="form-body flex-dir-column" action="/medicamentos/editar/@Model.Id" method="post">
    <input type="hidden" name="acaoAutomatica" id="acaoAutomaticaTrigger" value=""/>

    <div class="card">
        <div class="cabecalho">
            <span>INFORME OS NOVOS DADOS</span>
        </div>

        <div class="card-form flex-dir-column">
                <label class="form-label" for="nome">Nome do Medicamento:</label>
                <input class="form-box" onchange="document.getElementById('acaoAutomaticaTrigger').value='informarNome'; this.form.submit();" 
                type="text" name="nome" id="nome" value="@Model.Nome"/>

                <label class="form-label" for="qtdestoque">Quantidade em Estoque:</label>
                <input class="form-box" onchange="document.getElementById('acaoAutomaticaTrigger').value='informarQuantidade'; this.form.submit();" 
                type="text" name="qtdestoque" id="qtdestoque" value="@Model.QtdEstoque"/>

                <label class="form-label" for="descricao">Descrição:</label>
                <input class="form-box" onchange="document.getElementById('acaoAutomaticaTrigger').value='informarDescricao'; this.form.submit();" 
                type="text" name="descricao" id="descricao" value="@Model.Descricao"/>

                <label class="form-label" for="fornecedorID">Fornecedor do Medicamento:</label>
                <select required onchange="document.getElementById('acaoAutomaticaTrigger').value='selecionarFornecedor'; this.form.submit();"
                class="text-nowrap" name="fornecedorID" id="fornecedorID">
                <option disabled value="">
                    @if (Model.FornecedoresDisponiveis.Count == 0)
                    {
                        @:Nenhum Fornecedor Encontrado
                    }
                    else if (string.IsNullOrWhiteSpace(Model.Nome))
                    {
                        @:Digite o Nome do Medicamento Acima
                    }
                    else if (Model.QtdEstoque == 0)
                    {
                        @:Insira a Quantidade em Estoque Inicial Acima
                    }
                    else if (string.IsNullOrWhiteSpace(Model.Descricao))
                    {
                        @:Digite a Descrição do Medicamento Acima
                    }
                    else if (Model.FornecedorId == Guid.Empty)
                    {
                        @:Selecione um Fornecedor
                    }
                    else
                    {
                        @:Mude o Fornecedor ou Finalize :)
                    }
                    </option>
                    @foreach(SelecionarFornecedorViewModel f in Model.FornecedoresDisponiveis)
                    {
                        <option value="@f.Id" @(f.Id == Model.FornecedorId ? "selected" : "")>@f.Nome</option>
                    }
                </select

            <div class="btns-interact">
                <button class="btn" name="btnSubmit" value="cancelar" formnovalidate>Cancelar</button>
                <button class="btn" name="btnSubmit" value="editar">Editar</button>
            </div>
        </div>
    </div>
</form>