@using ControleDeMedicamentos.WebApp.Models

@{
    ViewBag.Titulo = "Edição de Medicamento";
}

@model EditarMedicamentoViewModel;
<link rel="stylesheet" href="~/css/update.css">

<form class="form-body flex-dir-column" id="form-medicamento" action="/medicamentos/editar/@Model.Id" method="post">
    <div class="card">
        <div class="cabecalho">
            <span>INFORME OS NOVOS DADOS</span>
        </div>

        <div class="card-form flex-dir-column">
            <label class="form-label" for="nome">Nome do Medicamento:</label>
            <input required class="form-box" type="text" placeholder="Nome" name="nome" id="nome" value="@Model.Nome"/>
            <span class="invalidInput text-break-word" id="nomeInvalidInput"></span>

            <label class="form-label" for="qtdEstoque">Quantidade em Estoque:</label>
            <input required class="form-box" type="number" placeholder="Quantidade" name="qtdEstoque" id="qtdEstoque" value="@Model.QtdEstoque"/>
            <span class="invalidInput text-break-word" id="qtdEstoqueInvalidInput"></span>

            <label class="form-label" for="descricao">Descrição:</label>
            <input required class="form-box" type="text" placeholder="Descrição" name="descricao" id="descricao" value="@Model.Descricao"/>
            <span class="invalidInput text-break-word" id="descricaoInvalidInput"></span>

            <label class="form-label" for="fornecedorId">Fornecedor do Medicamento:</label>
            <select required class="text-nowrap" name="fornecedorId" id="fornecedorId">
                <option id="optionInterativa" disabled value="@(Model.FornecedorId == Guid.Empty ? "selected" : "")"></option>
                    @foreach (SelecionarFornecedorViewModel f in Model.FornecedoresDisponiveis)
                    {
                        <option value="@f.Id" @(f.Id == Model.FornecedorId ? "selected" : "")>@(f.Nome!.Length > 27 ? f.Nome.Substring(0, 27) + "..." : f.Nome)</option>
                    }
                </select    

            <div class="btns-interact">
                <button class="btn" name="btnSubmit" value="cancelar" formnovalidate>Cancelar</button>
                <button class="btn" type="submit" name="btnSubmit" value="editar">Editar</button>
            </div>
        </div>
    </div>
</form>
@section Scripts {
        <script src="~/js/medicamento.js"></script>
}