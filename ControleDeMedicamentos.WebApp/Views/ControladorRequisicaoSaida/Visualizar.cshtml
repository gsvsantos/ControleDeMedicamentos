@using ControleDeMedicamentos.WebApp.Models;

@{
	ViewBag.Titulo = "Visualização de Requisições de Saída";
}

@model VisualizarRequisicaoSaidaViewModel;
<link rel="stylesheet" href="~/css/read.css">

<div class="card">
	<div class="acao-cadastro psides-30 flex-flex-dir-row">
		<a href="/requisicoes-saida/cadastrar" class="botaoCadastrar">Realizar Nova Requisição de Saída</a>
	</div>

	@if (Model.Registros.Count == 0)
	{
		<p class="flex-center">Nenhuma requisição de saída cadastrada.</p>
	}
	else
	{
		<table class="lista">
			<thead>
				<tr>
					<th class="paciente">PACIENTE</th>
					<th class="data">DATA DA REQUISIÇÃO</th>
					<th class="acoes"></th>
				</tr>
			</thead>
			<tbody>
				@foreach (DataRequisicaoSaidaViewModel rE in Model.Registros)
				{
					<tr>
							<td class="paciente text-nowrap">@rE.NomePaciente</td>
						<td class="data text-nowrap">@rE.Data.ToShortDateString()</td>
						<td class="acoes flex-dir-column">
							<a href="/requisicoes-saida/excluir/@rE.Id" class="btn-action btn-excluir flex-center">Excluir</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
</div>