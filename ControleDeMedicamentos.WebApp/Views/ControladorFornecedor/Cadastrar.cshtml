@using ControleDeMedicamentos.WebApp.Models

@{
    ViewBag.Titulo = "Cadastro de Fornecedor";
}

@model CadastrarFornecedorViewModel;
<link rel="stylesheet" href="~/css/create.css">

<form id="form-fornecedor" class="form-body flex-dir-column" action="/fornecedores/cadastrar" method="post">
    <div class="card">
        <div class="cabecalho">
            <span>INFORME OS DADOS</span>
        </div>

        <div class="card-form flex-dir-column">
                <label class="form-label" for="nome">Nome do Fornecedor</label>
                <input required class="form-box" type="text" placeholder="Nome" id="nome" name="nome"/>
                <span class="invalidInput text-break-word" id="nomeInvalido"></span>

                <label class="form-label" for="telefone">Telefone do Fornecedor</label>
                <input required class="form-box" type="text" placeholder="Telefone" id="telefone" name="telefone"/>
                <span class="invalidInput text-break-word" id="telefoneInvalido"></span>

                <label class="form-label" for="cnpj">C.N.P.J. do Fornecedor</label>
                <input required class="form-box" type="text" placeholder="C.N.P.J." id="cnpj" name="cnpj"/>
                <span class="invalidInput text-break-word" id="cnpjInvalido"></span>

            <div class="btns-interact">
                <a class="btn" href="/fornecedores/visualizar" value="voltar" formnovalidate>Voltar</a>
                <button class="btn" type="reset">Limpar</button>
                <button class="btn" name="btnSubmit" value="cadastrar">Cadastrar</button>
            </div>
        </div>
    </div>
</form>
@section Scripts {
            <script src="~/js/fornecedor.js"></script>
}