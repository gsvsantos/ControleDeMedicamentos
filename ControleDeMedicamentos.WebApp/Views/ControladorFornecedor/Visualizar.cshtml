@using ControleDeMedicamentos.WebApp.Models

@{
    ViewBag.Titulo = "Visualização de Fornecedores";
}

@model VisualizarFornecedorViewModel;
<link rel="stylesheet" href="~/css/read.css">
<link rel="stylesheet" href="~/css/read-pages/visualizar-fornecedor.css">

<div class="card">
	<div class="acao-cadastro psides-30 flex-dir-row">
		<a href="/fornecedores/cadastrar" class="botaoCadastrar">Cadastrar Novo Fornecedor</a>
	</div>

	@if (Model.Registros.Count == 0)
	{
		<p class="flex-center">Nenhum fornecedor cadastrado.</p>
	}
	else
	{
		<table class="lista">
			<thead>
				<tr>
					<th class="nome">NOME</th>
					<th class="telefone">TELEFONE</th>
					<th class="cnpj">CNPJ</th>
					<th class="acoes"></th>
				</tr>
			</thead>
			<tbody>
				@foreach (DataFornecedorViewModel f in Model.Registros)
				{
					<tr class="linha-fornecedor">
						<td class="nome text-nowrap">@f.Nome</td>
						<td class="telefone text-nowrap">@f.Telefone</td>
						<td class="cnpj text-nowrap">@f.CNPJ</td>
						<td class="acoes flex-dir-column">
							<a href="/fornecedores/editar/@f.Id" class="btn-action btn-editar flex-center">Editar</a>
							<a href="/fornecedores/excluir/@f.Id" class="btn-action btn-excluir flex-center">Excluir</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
</div>