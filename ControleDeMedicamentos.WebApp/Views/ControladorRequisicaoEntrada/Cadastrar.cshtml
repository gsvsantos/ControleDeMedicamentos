@using ControleDeMedicamentos.WebApp.Models

@{
	ViewBag.Titulo = "Cadastro de Requisição de Entrada";
}
@model CadastrarRequisicaoEntradaViewModel;
<link rel="stylesheet" href="~/css/create.css">

<form id="form-rentrada" class="form-body flex-dir-column" action="/requisicoes-entrada/cadastrar" method="post">
	<div class="card">
		<div class="cabecalho">
			<span>INFORME OS DADOS</span>
		</div>

		<div class="card-form flex-dir-column">
			<label class="form-label" for="funcionarioId">Funcionário Requerente:</label>
			<select required class="text-nowrap" name="funcionarioId" id="funcionarioId">
				<option id="optionPacienteInterativa" disabled value="" @(Model.FuncionarioId == Guid.Empty ? "selected" : "")></option>
				@foreach (SelecionarFuncionarioViewModel f in Model.FuncionariosDisponiveis)
				{
						<option value="@f.Id" @(f.Id == Model.FuncionarioId ? "selected" : "")>@(f.Nome!.Length > 27 ? f.Nome.Substring(0, 27) + "..." : f.Nome)</option>
				}
			</select>

			<label class="form-label" for="medicamentoId">Medicamento Requisitado</label>
			<select required class="text-nowrap" name="medicamentoId" id="medicamentoId">
				<option id="optionMedicamentoInterativa" disabled value="" @(Model.MedicamentoId == Guid.Empty ? "selected" : "")></option>
				@foreach (SelecionarMedicamentoViewModel m in Model.MedicamentosDisponiveis)
				{
						<option value="@m.Id" @(m.Id == Model.MedicamentoId ? "selected" : "")>@(m.Nome!.Length > 27 ? m.Nome.Substring(0, 27) + "..." : m.Nome)</option>
				}
			</select>

			<label class="form-label" for="quantidadeMedicamento">Quantidade Requisitada</label>
			<input required class="form-box" type="number" placeholder="Quantidade" name="quantidadeMedicamento" id="quantidadeMedicamento" value="@(Model.QuantidadeMedicamento == 0 ? "" : $"{@Model.QuantidadeMedicamento}")"/>
			<span class="invalidInput text-break-word" id="quantidadeInvalidInput"></span>

			<div class="btns-interact">
				<button class="btn" name="btnSubmit" value="voltar" formnovalidate>Voltar</button>
				<button class="btn" name="btnSubmit" value="limpar" formnovalidate>Limpar</button>
				<button class="btn" name="btnSubmit" value="cadastrar">Cadastrar</button>
			</div>
		</div>
	</div>
</form>
@section Scripts {
			<script src="~/js/requisicaoEntrada.js"></script>
}