@using ControleDeMedicamentos.WebApp.Models

@{
    ViewBag.Titulo ="Visualização de Pacientes";
}

@model VisualizarPacienteViewModel;
<link rel="stylesheet" href="~/css/read.css">
<link rel="stylesheet" href="~/css/read-pages/visualizar-paciente.css">

<div class="card">
    <div class="acao-cadastro psides-30 flex-dir-row">
        <a href="/pacientes/cadastrar" class="botaoCadastrar">Cadastrar Novo Paciente</a>
    </div>

    @if (Model.Registros.Count == 0)
    {
        <p class="flex-center">Nenhum pacientes cadastrado.</p>
    }
    else
    {
        <table class="lista">
            <thead>
                <tr>
                    <th class="nome">NOME</th>
                    <th class="telefone">TELEFONE</th>
                    <th class="cartaoSUS">CARTÃO S.U.S.</th>
					<th class="acoes"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (DataPacienteViewModel p in Model.Registros)
                {
                    <tr class="linha-paciente">
                        <td class="nome text-nowrap">@p.Nome</td>
                        <td class="telefone text-nowrap">@p.Telefone</td>
                        <td class="cartaoSUS text-nowrap">@p.CartaoSus</td>
                        <td class="acoes flex-dir-column">
                            <a href="/pacientes/editar/@p.Id" class="btn-action btn-editar flex-center">Editar</a>
                            <a href="/pacientes/excluir/@p.Id" class="btn-action btn-excluir flex-center">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>