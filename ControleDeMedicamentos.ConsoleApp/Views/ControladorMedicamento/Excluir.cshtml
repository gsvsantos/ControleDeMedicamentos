@using ControleDeMedicamentos.ConsoleApp.Models

@model ExcluirMedicamentoViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Exclusão de Medicamento - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Medicamentos</h1>

<h3>Exclusão de Medicamento</h3>

<p>Você realmente deseja excluir o registro #'@Model.Id' - '@Model.Nome'?</p>

<form action="/medicamentos/excluir/@Model.Id" method="post">
    <button type="submit">Confirmar</button>
    <a type="button" href="/medicamentos/visualizar">Cancelar</a>
</form>
</body>
</html>