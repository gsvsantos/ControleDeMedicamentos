@using ControleDeMedicamentos.ConsoleApp.Models

@model CadastrarMedicamentoViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Cadastro de Medicamentos - Controle de Medicamentos</title>    
</head>
<body>
<h1>Gestão de Medicamentos</h1>

<hr/>

<a href="/medicamentos">Voltar</a> /
<a href="/medicamentos/visualizar">Visualizar Medicamentos</a>

<hr/>

<h3>Cadastro de Medicamento</h3>

<form action="/medicamentos/cadastrar" method="post">
    <label for="nome">Nome do Medicamento:</label>
    <br/>
    <input type="text" name="nome" id="nome"/>

    <br/>

    <label for="qtdestoque">Quantidade em Estoque:</label>
    <br/>
    <input type="text" name="qtdestoque" id="qtdestoque"/>

    <br/>

    <label for="descricao">Descrição:</label>
    <br/>
    <input type="text" name="descricao" id="descricao"/>

    <br/>
    <label for="fornecedorID">Fornecedor do Medicamento:</label>
    <br/>
    <select id="fornecedorID" name="fornecedorID">
        @foreach(SelecionarFornecedorViewModel f in Model.FornecedoresDisponiveis)
        {
            <option value="@f.Id">@f.Nome</option>
        }
    </select>
        
    <hr/>

    <button type="submit">Cadastrar</button>
</form>
</body>
</html>