@using ControleDeMedicamentos.ConsoleApp.Models

@{
    ViewBag.Titulo = "Exclusão de Prescrição Médica";
}

@model ExcluirPrescricaoMedicaViewModel;
<link rel="stylesheet" href="~/css/delete.css">

<div class="card">
    <div class="delete-body flex-dir-column text-align">
        <div class="delete-msg text-nowrap">
            <span>Você realmente deseja excluir a prescrição do paciente '@Model.NomePaciente'?</span>
        </div>
    
        <form action="/prescricoes/excluir/@Model.Id" method="post">
            <button class="btnConfirmar" type="submit">Confirmar</button>
            <a class="btnCancelar" type="button" href="/prescricoes/visualizar">Cancelar</a>
        </form>
    </div>
</div>