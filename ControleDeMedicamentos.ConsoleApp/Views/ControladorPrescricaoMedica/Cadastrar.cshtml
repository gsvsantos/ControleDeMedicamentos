@using ControleDeMedicamentos.ConsoleApp.Models

@{
    ViewBag.Titulo ="Cadastro de Prescrição Médica";
}

@model CadastrarPrescricaoMedicaViewModel;
<link rel="stylesheet" href="~/css/create.css">
<link rel="stylesheet" href="~/css/create-pages/cadastrar-prescricao.css">
<link rel="stylesheet" href="~/css/read.css">
<form class="form-body flex-dir-column" action="/prescricoes/cadastrar" method="post">
    <div class="body-prescricao flex-dir-row">
        <div class="card card-prescricao">
            <div class="cabecalho">
                <span>INFORME OS DADOS</span>
            </div>
        
            <div class="card-form flex-dir-column">
                    <label class="form-label" for="cRMMedico">C.R.M. do Médico</label>
                    <input class="form-box" type="text" placeholder="C.R.M." name="cRMMedico" id="cRMMedico">
                    <label class="form-label" for="pacienteID">Paciente:</label>
                    <select required class="text-nowrap" name="pacienteID" id="pacienteID">
                        @if (@Model.PacientesDisponiveis.Count == 0)
                        {
                            <option value="" selected disabled>Nenhum paciente registrado</option>
                        }
                        else
                        {
                            @foreach(SelecionarPacienteViewModel p in Model.PacientesDisponiveis)
                            {
                                <option value="@p.Id" @(p.Id == Model.PacienteId ? "selected" : "")>@p.Nome</option>
                            }
                        }
                    </select>
        
                    <span>Medicamentos Prescritos:</span>
        
                    @if (!Model.MedicamentosPrescritos.Any())
                    {
                    <p class="fw-semibold">Ainda não há nenhum medicamento relacionado à prescrição...</p>
                    }
                    else
                    {
                    <table class="lista">
                        <thead>
                            <tr>
                                <th class="medicamento">Medicamento</th>
                                <th class="dosagem">Dosagem</th>
                                <th class="periodo">Período</th>
                                <th class="quantidade">Quantidade</th>
                            </tr>
                        </thead>
                        <tbody>
                                @foreach (var medicamento in Model.MedicamentosPrescritos)
                                {
                                    <tr>
                                        <td class="medicamento">@medicamento.Medicamento</td>
                                        <td class="dosagem">@medicamento.Dosagem</td>
                                        <td class="periodo">@medicamento.Periodo</td>
                                        <td class="quantidade">@medicamento.Quantidade</td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                    }
        
                    <div class="btns-interact">
                        <button class="btn" name="btnSubmit" value="voltar">Voltar</button>
                        <button class="btn" name="btnSubmit" value="limpar">Limpar</button>
                        <button class="btn" name="btnSubmit" value="cadastrar">Cadastrar</button>
                    </div>
            </div>
        </div>
        
        <div class="card card-medicamentos flex-dir-column">
        
            <div class="cabecalho">
                <span>ADICIONAR MEDICAMENTOS</span>
            </div>
                    <select required class="text-nowrap" name="medicamentoId" id="medicamentosDisponiveis">
                        @if (@Model.MedicamentosDisponiveis.Count == 0)
                        {
                            <option value="" selected disabled>Nenhum medicamento registrado</option>
                        }
                        else
                        {
                            @foreach (SelecionarMedicamentoViewModel m in Model.MedicamentosDisponiveis)
                            {
                            <option value="@m.Id" @(m.Id == Model.MedicamentoId ? "selected" : "")>@m.Nome</option>
                            }
                        }
                    </select>
        
                    <label class="form-label" for="dosagemMedicamento">Dosagem:</label>
                    <input class="form-box" type="text" placeholder="Dosagem" name="dosagemMedicamento" id="dosagemMedicamento"/>
                    <label class="form-label" for="periodoMedicamento">Período:</label>
                    <input class="form-box" type="text" placeholder="Período" name="periodoMedicamento" id="periodoMedicamento"/>
                    <label class="form-label" for="quantidadeMedicamento">Quantidade (Caixas/Frascos):</label>
                    <input class="form-box" type="number" placeholder="Quantidade" name="quantidadeMedicamento" id="quantidadeMedicamento"/>
        
                    <button class="btn" name="btnSubmit" value="adicionarMedicamento" >Adicionar Medicamento</button>
        </div>
    </div>
</form>