@using ControleDeMedicamentos.ConsoleApp.Models

@model ExcluirPacienteViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Exclusão de Paciente - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Pacientes</h1>

<h1>Exclusão de Paciente</h1>

<p>Você realmente deseja excluir o registro #'@Model.Id' - '@Model.Nome'?</p>

<form action="/paciente/excluir/@Model.Id" method="post">
    <button type="submit">Confirmar</button>
    <a type="button" href="/paciente/visualizar">Cancelar</a>
</form>
</body>
</html>