@using ControleDeMedicamentos.ConsoleApp.Models

@model EditarPacienteViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Edição de Paciente - Controle de Medicamento</title>
</head>
<body>
<h1>Gestão de Pacientes</h1>

<hr/>

<a href="/paciente">Voltar</a> /
<a href="/paciente/visualizar">Visualizar Pacientes</a>

<hr/>

<form action="/paciente/editar/@Model.Id" method="post">
    <label for="nome">Nome do Paciente</label>
    <br/>
    <input type="text" id="nome" name="nome" value="@Model.Nome"/>

    <br/>

    <label for="telefone">Telefone do Paciente</label>
    <br/>
    <input type="text" id="telefone" name="telefone" value="@Model.Telefone"/>

    <br/>

    <label for="cartaoSus">CartãoSUS do Paciente</label>
    <br/>
    <input type="text" id="cartaoSus" name="cartaoSus" value="@Model.CartaoSus"/>

    <hr/>

    <button type="submit">Editar</button>
</form>
</body>
</html>