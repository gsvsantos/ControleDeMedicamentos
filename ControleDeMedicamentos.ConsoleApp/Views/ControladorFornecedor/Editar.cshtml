@using ControleDeMedicamentos.ConsoleApp.Models

@model EditarFornecedorViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="UTF-8"/>
	<title>Edição de Fornecedor - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Fornecedores</h1>

<hr/>

<a href="/fornecedor">Voltar</a> /
<a href="/fornecedor/visualizar">Visualizar Fornecedores</a>

<hr/>

<h3>Edição de Fornecedor</h3>

<form action="/fornecedor/editar/@Model.Id" method="post">
	<label for="nome">Nome do Fornecedor</label>
	<br/>
	<input type="text" id="nome" name="nome" value="@Model.Nome"/>

	<br/>

	<label for="telefone">Telefone do Fornecedor</label>
	<br/>
	<input type="text" id="telefone" name="telefone" value="@Model.Telefone"/>

	<br/>

	<label for="cnpj">CNPJ do Fornecedor</label>
	<br/>
	<input type="text" id="cnpj" name="cnpj" value="@Model.CNPJ"/>

	<hr/>

	<button type="submit">Editar</button>
</form>
</body>
</html>