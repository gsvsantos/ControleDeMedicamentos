@using ControleDeMedicamentos.ConsoleApp.ModuloFornecedor

@{
    Fornecedor f = ViewBag.Fornecedor;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Exclusão de Fornecedor - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Fornecedores</h1>

<h3>Exclusão de Fornecedor</h3>

<p>Você realmente deseja excluir o registro #'@f.Id' - '@f.Nome'?</p>

<form action="/fornecedor/excluir/@f.Id" method="post">
    <button type="submit">Confirmar</button>
    <a type="button" href="/fornecedor/visualizar">Cancelar</a>
</form>
</body>
</html>