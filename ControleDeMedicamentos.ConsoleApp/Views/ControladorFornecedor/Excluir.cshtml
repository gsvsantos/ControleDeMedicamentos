@using ControleDeMedicamentos.ConsoleApp.Models

@model ExcluirFornecedorViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Exclusão de Fornecedor - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Fornecedores</h1>

<h3>Exclusão de Fornecedor</h3>

<p>Você realmente deseja excluir o registro #'@Model.Id' - '@Model.Nome'?</p>

<form action="/fornecedor/excluir/@Model.Id" method="post">
    <button type="submit">Confirmar</button>
    <a type="button" href="/fornecedor/visualizar">Cancelar</a>
</form>
</body>
</html>