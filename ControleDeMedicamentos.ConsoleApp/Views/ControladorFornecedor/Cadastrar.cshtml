<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Cadastro de Fornecedor - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Fornecedores</h1>

<hr/>

<a href="/fornecedor">Voltar</a> /
<a href="/fornecedor/visualizar">Visualizar Fornecedores</a>

<hr/>

<h3>Cadastro de Fornecedor</h3>

<form action="/fornecedor/cadastrar" method="post">
    <label for="nome">Nome do Fornecedor</label>
    <br/>
    <input type="text" id="nome" name="nome"/>

    <br/>

    <label for="telefone">Telefone do Fornecedor</label>
    <br/>
    <input type="text" id="telefone" name="telefone"/>

    <br/>

    <label for="cnpj">CNPJ do Fornecedor</label>
    <br/>
    <input type="text" id="cnpj" name="cnpj"/>

    <hr/>

    <button type="submit">Cadastrar</button>
</form>
</body>
</html>