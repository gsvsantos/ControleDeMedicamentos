@using ControleDeMedicamentos.ConsoleApp.Models;

@{
	ViewBag.Titulo = "Visualização de Requisições de Entrada";
}

@model VisualizarRequisicaoEntradaViewModel;
<link rel="stylesheet" href="~/css/read.css">
<link rel="stylesheet" href="~/css/read-pages/visualizar-requisicao-entrada.css">

<div class="card">
	<div class="acao-cadastro psides-30 flex-flex-dir-row">
		<a href="/requisicoes-entrada/cadastrar" class="botaoCadastrar">Realizar Nova Requisição de Entrada</a>
	</div>

	@if (Model.Registros.Count == 0)
	{
		<p class="flex-center">Nenhuma requisição de entrada cadastrada.</p>
	}
	else
	{
		<table class="lista">
			<thead>
				<tr>
					<th class="funcionario">FUNCIONÁRIO REQUERENTE</th>
					<th class="medicamento">MEDICAMENTO REQUISITADO</th>
					<th class="quantidade">QUANTIDADE REQUISITADA</th>
					<th class="data">DATA DA REQUISIÇÃO</th>
					<th class="acoes"></th>
				</tr>
			</thead>
			<tbody>
				@foreach (DataRequisicaoEntradaViewModel rE in Model.Registros)
				{
					<tr>
						<td class="funcionaro text-nowrap">@rE.NomeFuncionario</td>
						<td class="medicamento text-nowrap">@rE.NomeMedicamento</td>
						<td class="quantidade text-nowrap">@rE.QuantidadeMedicamento</td>
						<td class="data text-nowrap">@rE.Data.ToShortDateString()</td>
						<td class="acoes flex-dir-column">
							<a href="/requisicoes-entrada/excluir/@rE.Id" class="btn-action btn-excluir flex-center">Excluir</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
</div>