@using ControleDeMedicamentos.ConsoleApp.Models

@{
    ViewBag.Titulo = "Cadastro de Requisição de Entrada";
}
@model CadastrarRequisicaoEntradaViewModel;
<link rel="stylesheet" href="~/css/create.css">

<form class="form-body flex-dir-column" action="/requisicoes-entrada/cadastrar" method="post">
    <div class="card">
        <div class="cabecalho">
            <span>INFORME OS DADOS</span>
        </div>

        <div class="card-form flex-dir-column">
            <label class="form-label" for="funcionarioID">Funcionário Requerente:</label>
            <select required class="text-nowrap" name="funcionarioID" id="funcionarioID">
                @if (Model.FuncionariosDisponiveis.Count == 0)
                {
                    <option selected disabled value="">Nenhum funcionário cadastrado</option>
                }

                else
                {
                    @foreach (SelecionarFuncionarioViewModel f in Model.FuncionariosDisponiveis)
                    {
                        <option value="@f.Id">@f.Nome</option>
                    }
                }
            </select>
            <label class="form-label" for="medicamentoID">Medicamento Requisitado</label>
            <select required class="text-nowrap" name="medicamentoID" id="medicamentoID">
                @if (Model.MedicamentosDisponiveis.Count == 0)
                {
                    <option select disabled value="">Nenhum medicamento cadastrado</option>
                }

                else
                {
                    @foreach (SelecionarMedicamentoViewModel m in Model.MedicamentosDisponiveis)
                    {
                        <option value="@m.Id">@m.Nome</option>
                    }
                }
            </select>
            <label class="form-label" for="quantidadeMedicamento">Quantidade Requisitada</label>
            <input class="form-box" type="number" placeholder="Quantidade" name="quantidadeMedicamento" id="quantidadeMedicamento"/>
            <button class="btn" type="submit">Cadastrar</button>
		</div>
	</div>
</form>