@using ControleDeMedicamentos.ConsoleApp.Models

@model VisualizarFuncionarioViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Visualização de Funcionários - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Funcionários</h1>

<hr/>

<a href="/funcionario">Voltar</a> /
<a href="/funcionario/cadastrar">Cadastrar Novo Funcionário</a>

<hr/>

<h3>Visualização de Funcionários</h3>

<ul>
    @if (Model.Registros.Count == 0)
    {
        <li>Nenhum fornecedor cadastrado.</li>
    }

        @foreach (DataFuncionarioViewModel f in Model.Registros)
    {
    <li>@f <a href="/funcionario/editar/@f.Id">Editar</a> /
            <a href="/funcionario/excluir/@f.Id">Excluir</a> </li>
    }
</ul>
</body>
</html>