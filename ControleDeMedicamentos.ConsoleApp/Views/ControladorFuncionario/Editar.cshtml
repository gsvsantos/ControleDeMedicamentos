@using ControleDeMedicamentos.ConsoleApp.Models

@model EditarFuncionarioViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Edição de Funcionário - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Funcionários</h1>

<hr/>

<a href="/funcionario">Voltar</a> /
<a href="/funcionario/visualizar">Visualizar Funcionários</a>

<hr/>

<h3>Edição de Funcionário</h3>

<form action="/funcionario/editar/@Model.Id" method="post">
    <label for="nome">Nome do Funcionário</label>
    <br/>
    <input type="text" id="nome" name="nome" value="@Model.Nome"/>
    
    <br/>

    <label for="telefone">Telefone do Funcionário</label>
    <br/>
    <input type="text" id="telefone" name="telefone" value="@Model.Telefone"/>

    <br/>
        
    <label for="cpf">CPF do Funcionário</label>
    <br/>
    <input type="text" id="cpf" name="cpf" value="@Model.CPF"/>

    <hr/>
    
    <button type="submit">Editar</button>
</form>
</body>
</html>