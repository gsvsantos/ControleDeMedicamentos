@using ControleDeMedicamentos.ConsoleApp.ModuloFuncionario

@{
    Funcionario f = ViewBag.Funcionario;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Edição de Funcionário - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Funcionários</h1>

<hr/>

<a href="/funcionario">Voltar</a> /
<a href="/funcionario/visualizar">Visualizar Funcionários</a>

<hr/>

<h3>Edição de Funcionário</h3>

<form action="/funcionario/editar/@f.Id" method="post">
    <label for="nome">Nome do Funcionário</label>
    <br/>
    <input type="text" id="nome" name="nome" value="@f.Nome">
    
    <br/>

    <label for="telefone">Telefone do Funcionário</label>
    <br/>
    <input type="text" id="telefone" name="telefone" value="@f.Telefone">

    <br/>
        
    <label for="cpf">CPF do Funcionário</label>
    <br/>
    <input type="text" id="cpf" name="cpf" value="@f.CPF">

    <hr/>
    
    <button type="submit">Editar</button>
</form>
</body>
</html>