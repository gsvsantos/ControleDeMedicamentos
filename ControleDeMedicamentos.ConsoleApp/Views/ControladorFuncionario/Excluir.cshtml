@using ControleDeMedicamentos.ConsoleApp.Models

@model ExcluirFuncionarioViewModel;

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8"/>
    <title>Exclusão de Funcionário - Controle de Medicamentos</title>
</head>
<body>
<h1>Gestão de Funcionários</h1>

<h3>Exclusão de Funcionário</h3>

<p>Você realmente deseja excluir o registro #'@Model.Id' - '@Model.Nome'?</p>

<form action="/funcionario/excluir/@Model.Id" method="post">
    <button type="submit">Confirmar</button>
    <a type="button" href="/funcionario/visualizar">Cancelar</a>
</form>
</body>
</html>